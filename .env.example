# Template only. Do not reuse any values from existing VDS/Driving School.
# Copy to .env and fill with unique locally generated values (never commit .env).
COMPOSE_PROJECT_NAME=supabase_lite_example
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_UNIQUE_JWT_SECRET_AT_LEAST_32_CHARS
ANON_KEY=REPLACE_WITH_SIGNED_ANON_JWT
SERVICE_ROLE_KEY=REPLACE_WITH_SIGNED_SERVICE_ROLE_JWT
API_PUBLIC_URL=https://api.example.invalid
SITE_URL=https://app.example.invalid
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_SECRET
SMTP_SENDER_NAME=Example
SMTP_ADMIN_EMAIL=admin@example.invalid
STORAGE_FILE_SIZE_LIMIT=52428800
# Experimental compose only; values must be generated per installation
AUTH_DB_PASSWORD=REPLACE_WITH_UNIQUE_AUTH_DB_PASSWORD
AUTHENTICATOR_PASSWORD=REPLACE_WITH_UNIQUE_AUTHENTICATOR_PASSWORD
STORAGE_DB_PASSWORD=REPLACE_WITH_UNIQUE_STORAGE_DB_PASSWORD
REALTIME_DB_ENC_KEY=REPLACE_WITH_UNIQUE_16_BYTE_KEY
REALTIME_SECRET_KEY_BASE=REPLACE_WITH_UNIQUE_64_CHAR_BASE
GATEWAY_PORT=28100
